/* Product Catalog Styles - Exact Image 2 Match */
.product-section {
  background-color: #f4f4f4 !important;
  padding: 4rem 0;
  color: #000;
}

.cat-header-wrapper {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 2rem;
  border-bottom: 2px solid #e0e0e0;
  padding-bottom: 1rem;
}

.cat-header {
  position: relative;
}

.cat-header .section-title {
  margin: 0;
  font-size: 1.75rem;
  font-weight: 900;
  color: #000;
  text-transform: uppercase;
}

.cat-header .section-title span {
  color: #000; 
}

.header-line {
  height: 4px;
  width: 50px;
  background-color: var(--primary);
  margin-top: 10px;
  position: absolute;
  bottom: -18px;
  left: 0;
}

.carousel-controls {
  display: flex;
  gap: 10px;
}

.control-btn {
  background: #fff;
  border: 1px solid #e0e0e0;
  color: #000;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s;
}

.control-btn:hover {
  background: #f8f8f8;
  border-color: #ccc;
}

.carousel-container {
  position: relative;
  width: 100%;
}

.product-carousel {
  display: flex;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  gap: 15px;
  padding: 10px 0 30px;
  -webkit-overflow-scrolling: touch;
}

.product-carousel::-webkit-scrollbar {
  display: none;
}

.carousel-item {
  flex: 0 0 calc(20% - 12px);
  scroll-snap-align: start;
  min-width: 240px;
}

@media (max-width: 1400px) {
  .carousel-item { flex: 0 0 calc(25% - 12px); }
}

@media (max-width: 992px) {
  .carousel-item { flex: 0 0 calc(50% - 10px); }
}

@media (max-width: 600px) {
  .carousel-item { flex: 0 0 100%; }
}

.product-card {
  background-color: #ffffff !important;
  border: 1px solid #e0e0e0;
  display: flex;
  flex-direction: column;
  height: 100%;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.product-img-wrapper {
  background-color: #ffffff;
  padding: 2rem 1rem;
  aspect-ratio: 1.1 / 1;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.product-img-wrapper img {
  max-width: 85%;
  max-height: 85%;
  object-fit: contain;
}

.product-brand-tag {
  position: absolute;
  top: 15px;
  left: 15px;
  background-color: #000;
  color: #fff;
  padding: 4px 10px;
  font-size: 8px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.product-info {
  padding: 1.2rem;
  flex-grow: 1;
  display: flex;
  flex-direction: column;
}

.product-name {
  color: #000 !important;
  font-size: 0.95rem;
  font-weight: 900;
  text-transform: uppercase;
  margin-bottom: 0.5rem;
  line-height: 1.2;
}

.product-description {
  color: #555 !important;
  font-size: 0.75rem;
  line-height: 1.5;
  margin-bottom: 1.2rem;
  flex-grow: 1;
  text-align: justify;
}

.product-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.btn-cotizar, .btn-info {
  padding: 10px 0;
  text-align: center;
  font-weight: 800;
  font-size: 0.7rem;
  text-transform: uppercase;
  text-decoration: none;
  transition: all 0.2s ease;
}

.btn-cotizar {
  background-color: #a6192e !important;
  color: #fff !important;
}

.btn-info {
  background-color: #fff !important;
  color: #000 !important;
  border: 1px solid #e0e0e0;
}

.btn-cotizar:hover {
  background-color: #8a1526;
}

.btn-info:hover {
  background-color: #f4f4f4;
  border-color: #ccc;
}

.carousel-legend {
  text-align: center;
  font-size: 0.65rem;
  color: #999;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  margin-top: 1rem;
  font-weight: 700;
}

/* Bento Specs V2 */
.specs-section-v2 {
  background-color: #0a0a0a;
  padding: 5rem 0;
}

.specs-layout-v2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  align-items: center;
}

@media (max-width: 992px) {
  .specs-layout-v2 {
    grid-template-columns: 1fr;
  }
}

.specs-title-v2 {
  color: #fff;
  font-size: clamp(1.8rem, 4vw, 2.5rem);
  font-weight: 900;
  text-transform: uppercase;
}

.specs-title-v2 .accent-text {
  color: var(--primary);
  font-style: italic;
}

.specs-desc-v2 {
  margin-top: 1rem;
  font-size: 0.95rem;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.6);
}

.spec-grid-v2 {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 2rem;
  margin-top: 2.5rem;
}

.spec-value-v2 {
  display: block;
  font-size: clamp(1.8rem, 3vw, 2.2rem);
  font-weight: 900;
  color: var(--primary);
  line-height: 1;
}

.spec-label-v2 {
  display: block;
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: rgba(255, 255, 255, 0.4);
  margin-top: 0.4rem;
  font-weight: 700;
}

.specs-image-v2 {
  position: relative;
  border-radius: 6px;
  overflow: hidden;
  aspect-ratio: 16 / 9;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
}

.specs-image-v2 img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.image-overlay-v2 {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.4), transparent);
}
