# ==============================================================================
# 1. REDIRECCIONES 301 DE SITELINKS DE GOOGLE (SEO Y NAVEGACIÓN A SECCIONES)
# ==============================================================================
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirecciones para las URL antiguas/sitelinks indexados en Google hacia la nueva estructura con anclas (#)
  RewriteRule ^caminadoras/?$ /gimnasio#trotadoras [R=301,NE,L]
  RewriteRule ^elipticas/?$ /gimnasio#elipticas [R=301,NE,L]
  RewriteRule ^ciclismo-estacionario/?$ /gimnasio#ciclismo-indoor [R=301,NE,L]
  RewriteRule ^multifuerzas/?$ /gimnasio#multigimnasios [R=301,NE,L]
  RewriteRule ^planos/?$ / [R=301,NE,L]
  RewriteRule ^contactanos/?$ /#contacto [R=301,NE,L]
  RewriteRule ^equipos-para-el-hogar/?$ /hogar [R=301,NE,L]
  RewriteRule ^bicicletas-de-ejercicio-lifecycle/?$ /gimnasio#bicicletas-verticales [R=301,NE,L]

# ==============================================================================
# 2. CONFIGURACIÓN PARA SPA (REACT + VITE + REACT ROUTER)
# Evita la pantalla en blanco / Error 404 al recargar cualquier subruta
# ==============================================================================
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>
